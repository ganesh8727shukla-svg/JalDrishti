# CDSE account credentials are required only for product downloads.
CDSE_USERNAME=
CDSE_PASSWORD=

# Relative paths resolve from the JalDrishti repository root.
JALDRISHTI_DATA_DIR=data/raw/sentinel1
JALDRISHTI_MAX_DOWNLOAD_BYTES=5368709120

# ESA SNAP is an external system application; do not install it from the API.
# Set the full path to SNAP's Graph Processing Tool after installing SNAP.
JALDRISHTI_SNAP_GPT=
JALDRISHTI_PROCESSED_DIR=data/processed/sentinel1
JALDRISHTI_SNAP_TIMEOUT_SECONDS=21600

# Download timeouts and bounded retry policy.
CDSE_DOWNLOAD_MAX_ATTEMPTS=3
CDSE_CONNECT_TIMEOUT_SECONDS=15
CDSE_READ_TIMEOUT_SECONDS=120
CDSE_RETRY_BACKOFF_SECONDS=1
CDSE_MAX_RETRY_WAIT_SECONDS=30
